#include "dkli.dkh"
#!
module "list.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"

    do @context.begin(@crud_context)

    ref @_GET = ifnull(@("&parameters"),record.create())
    ref data = ifnull(@("&./data"),list.create())
    ref itemactions = ifnull(@("&./itemactions"),list.create())
    ref itemreports = ifnull(@("&./itemreports"),list.create())

    // do rise_error(0,to.json(@("&.")))

	@_entities_type = @("$parameters/_entities_type")
	table_id = "tbl_"+@_entities_type

    tbtn_style = "cursor:pointer; text-decoration:none; outline:none; padding: 0px 8px; color:#000000;display: inline-block;
    font-weight: 400;
    line-height: 1.5;
    color: #212529;
    text-align: center;
    text-decoration: none;
    vertical-align: middle;
    cursor: pointer;
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
    background-color: transparent;
    border: 1px solid transparent;
    padding: .375rem .75rem;
    font-size: 1rem;
    border-radius: .25rem;
    transition: color .15s ease-in-out, background-color .15s ease-in-out, border-color .15s ease-in-out, box-shadow .15s ease-in-out;
    border:1px solid;
    padding: .25rem .5rem;
    font-size: .875rem;
    border-radius: 0 !important;
    "    
    
    new table_definition
    {
        @"datatable*": data
        member @"columns"
        {
            member @"nic" { @"caption": "NIC" }
            member @"cti" { @"caption": "CTI" }
            member @"predet" { @"caption": "Predeterminado" }
            member @"_actions"
            {
                @"caption":""
                @"template":ftext('<div>
                    <a href="./${DataRow.sys_pk}/cfg-certificado/" style="#<tbtn_style>">Configurar certificado</a>
                </div>')
            }
        }
        @"table_footer": "Mostrando los primeros # registros"
    }

    new nav_config
    {
        @"title": "Administración de emisores de CFDI"
        @"buttons*": @null
        @"urlexit": "/"
        @"main": "GX91,GX92,GX93"
        @"actions*": itemactions
        @"reports*": itemreports
        @"jscurrentcontext": "getCurrentContext"
    }

    #$ div(class="container-fluid p-0")
    {
        #! do uie.printV12FormBar(nav_config)

        #$ div(id="work_area" class="container-section mt-1 p-2 pt-0")
        {
            form(action="./" method="GET" id="form_filter" class="no-print my-1 d-flex py-1")
            {
                "filter-text"(
                    "id"="fil_text"
                    "text-field"="fil_text"
                    "placeholder"="Buscar ..."
                    "form"="#form_filter"
                    "value"="#<@('$parameters/fil_text')>"
                    "auto-submit"="true"
                    "class"="w-100"
                ){$""}
            }
            #! do uie.dbeditable(table_definition,table_id)
        }

		#$
		script(type="text/javascript")
		{$'
			function getCurrentContext()
			{
				const table = document.getElementById("#<table_id>");
				const id = (table?.DataArray[table.CurrentRowIndex()]?.sys_pk ?? "");
    			return { item_id:id, context: {} }
			}
		'}
    }
}
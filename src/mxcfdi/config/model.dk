#include "dkli.dkh"
#!
module "Configuración de emisores y cuentas de timbrado. :config"
{
    @table_name = "mxcfdi_emisor"
    @keyfield = "sys_pk"
    @sys_fields = "sys_pk,sys_guid,sys_dtcreated,sys_timestamp,sys_info,sys_user,sys_lastuser,sys_exported,sys_dtexported,sys_recver,sys_deleted,sys_lock"

    @create_fields = @sys_fields + ",nic,cti,pwd,predet"
    @update_fields = @sys_fields + ",nic,cti,pwd,predet"
    
    @create_exclude_fields = "sys_lastuser"
    @update_exclude_fields = "sys_pk,sys_guid,sys_dtcreated,sys_user"
    
    @create_alias_fields = ""
    @update_alias_fields = ""

    @list_query = "
    SELECT
        cfg.sys_pk,
        cfg.nic,
        cfg.cti,
        cfg.pwd,
        IF(cfg.predet,'Si','No') AS predet
    FROM #<@table_name> AS cfg
    WHERE NOT IFNULL(cfg.sys_deleted,0)
        #<conditions>
    LIMIT #<@default_max_rows>
    "

    @read_query = "
    SELECT
        cfg.sys_pk,
        cfg.sys_recver,
        cfg.nic,
        cfg.cti,
        cfg.pwd,
        IFNULL(cfg.predet,0) AS predet
    FROM #<@table_name> AS cfg
    WHERE cfg.#<@keyfield> = @_entity_id
        #<conditions>
    "
    @template_email_def='<html>
        <body style="width:100%;background: #ffffff; padding: 10px;">
            <h3 style="margin-top:10px;margin-bottom: 10px;">@subject</h3>
            <hr style=" margin-top: 5px; margin-bottom: 5px;border: 0; border-top: 1px solid rgba(31, 27, 27, 0.15);">
            <div>
                @body
            </div>
            <hr style=" margin-top: 5px; margin-bottom: 5px;border: 0; border-top: 1px solid rgba(31, 27, 27, 0.15);">
            <table width="100%">
                <tbody>
                    <tr>
                        <th>
                            <a href="http://induxsoft.net/" style="margin: 0 0 0 0px;"><img src="http://induxsoft.net/img/Logo.png" /></a>
                        </th>	
                        <th>
                        <b>Esta factura electrónica (CFDI) fue emitida a través de la plataforma de Induxsoft.</b>
                        </th>
                    </tr>
                </tbody>		
            </table>
        </body>
    </html>'
    evaluateFilters::&params
    {
        conditions = ""

        if trim(@@(params,"$fil_text")) != "" {
            conditions = conditions + "
            AND (cfg.nic LIKE CONCAT('%',@fil_text,'%')
                OR cfg.cti LIKE CONCAT('%',@fil_text,'%')
            )"
        }

        @list_query = ftext(@list_query)
    }

    list::&db,&params
    {
        do dbr.apps.action.grant("GX90")

        do config.evaluateFilters(params)
        new data
        {
            @"data*": entity.list(db,params)
            @"itemactions*": dbr.apps.itemactions(db,"DET083","action","",0)
            @"itemreports*": dbr.apps.itemactions(db,"DET083","report","",0)
        }
        return data

        exception
        {
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    read::&db,&params
    {
        do dbr.apps.action.grant("GX90")

        return entity.read(db,params)

        exception
        {
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    blank::&db,&params
    {
        do dbr.apps.action.grant("GX90")

        return record.create()

        exception
        {
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    create::&db,&params,&data
    {
        @use_transaction = @false

        do dbr.apps.action.pre("GX91")
        do dbr.begin(db)

        data<"predet"> : parse.bool(@@(data,"$predet"))
        if @@(data,"#predet") { do dbr.execute(db,ftext("UPDATE #<@table_name> SET predet = 0"),@null) }
        
        ref entity = entity.create(db,params,data)

        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        return entity

        exception{ do config.catch(db,params,data) }
    }

    update::&db,&params,&data
    {
        @use_transaction = @false

        do dbr.apps.action.pre("GX92")
        do dbr.begin(db)

        data<"predet"> : parse.bool(@@(data,"$predet"))
        if @@(data,"#predet") { do dbr.execute(db,ftext("UPDATE #<@table_name> SET predet = 0"),@null) }
        
        ref entity = entity.update(db,params,data)

        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        return entity

        exception{ do config.catch(db,params,data) }
    }

    delete::&db,&params
    {
        @use_transaction = @false

        do dbr.apps.action.pre("GX93")
        do dbr.begin(db)
        
        do entity.delete(db,params)

        do dbr.apps.action.pos(@null)
        do dbr.commit(db)
        do dbr.apps.action.ext(@null)

        exception{ do config.catch(db,params,@null) }
    }

    catch::&db,&params,&data
    {
        if isnull(data){ ref data:record.create() }
        if dbr.in_transaction(db){ do dbr.rollback(db) }

        ref FormData = record.copy(data,"*")
        code = last_error_code()
        error = last_error()

        do record.clear(data)
        data<"form*"> : FormData

        if isset("@@_action_context"){ do dbr.apps.action.log() }
        // do config.prepareView(db,params,data)
        do rise_error(code,error)
    }
    
    /*
     * Summary:
     * - seccion de correo
    */
    template_email::&db,&params
    {
        template=dbr.vars.get(db,"mxcfdi_template_email")
        if trim(template) == ""{template=@template_email_def}
        new entity
        {
            @"template":template
        }
        return entity
    }

    save.template::&db,&params,&data
    {
        do dbr.vars.set(db,"mxcfdi_template_email",@@(data,"$template"))
        @url_redir="/!/dbext/globalvar/"
        return data
    }
    configurar_certificado::&db,&params
    {
        ref cti=dbr.rec(db,"select e.sys_pk,e.nic,e.cti,e.pwd,e.predet from mxcfdi_emisor e where e.sys_pk=@_entity_id",params)
        new entity
        {
            @"cti*":cti
        }

        /*
         * Summary:
         * - obtener ids del perfil de indusoft
        */

        ref data_session = dbext.induxsoft.getSession(db,@@(@http_context,"$session/user/ids"))
        if not(@@(data_session,"#success")){do rise_error(500,@@(data_session,"$message"))}
        
        entity<"session*">:data_session
        if trim(@@(data_session,"$induxsoft_sid")) == ""{do rise_error(500,"No se logró obtener datos del perfil")}
        
        /*
         * Summary:
         * - obtener datos del emisor con base a la cti configurado
        */
        _cti = trim(@@(cti,"$cti"))

        url = replace(@svc_fdsk_get_emisor_v12,"@cti",_cti)
        url = replace(url,"@pwd",trim(@@(cti,"$pwd")))

        res=http.get(url)
        ref result=from.json(res)

        message=trim(@@(result,"$message"))
        ref data=@@(result,"&data")
        if message != "" && isnull(data)
        {
            if contains(message,_cti+"|")
            {
                entity<"message">:message
                return entity
            }
            do rise_error(99,message)
        }
        // https://app.factudesk.net/?rfc_emisor=PEPI010203311&nic=209874&mdl=1
        @form_view="template_fdsk.dk"
        entity<"emisor*">:data

        return entity
    }
    point @list to config.list
    point @read to config.read
    point @blank to config.blank

    point @create to config.create
    point @update to config.update
    point @delete to config.delete
}
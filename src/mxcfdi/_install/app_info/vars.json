[
    {
        "id": "mxcfdi",
        "caption": "Emisión de CFDI",
        "help": "Variables del paquete: mxcfdi",
        "vars": [
            {
                "varname": "mxcfdi_config",
                "vardefault": "",
                "varvalue": "/!/mxcfdi/config/",
                "varcaption": "Configuración de emisores",
                "varhelp": "Ir a administración de emisores de CFDI.",
                "vartype": "string",
                "varinput": {
                    "control": "button"
                }
            },
            {
                "varname": "mxcfdi_nventa",
                "vardefault": "0",
                "varvalue": "0",
                "varcaption": "No asumir facturas del módulo de venta",
                "varhelp": "Excluir Facturas y Devoluciones de los comprobantes de Ingreso y Egreso",
                "vartype": "bool",
                "varinput": {
                    "control": "select",
                    "source":{
                        "type":"list",
                        "values":[
                            {"val":"1", "text":"Si"},
                            {"val":"0", "text":"No"}
                        ],
                        "showfield":"text",
                        "keyfield":"val"
                    }
                }
            },
            {
                "varname": "mxcfdi_modif_subject_email",
                "vardefault": "0",
                "varvalue": "0",
                "varcaption": "Editar asunto del correo",
                "varhelp": "Permite editar el asunto del correo",
                "vartype": "bool",
                "varinput": {
                    "control": "select",
                    "source":{
                        "type":"list",
                        "values":[
                            {"val":"1", "text":"Sí"},
                            {"val":"0", "text":"No"}
                        ],
                        "showfield":"text",
                        "keyfield":"val"
                    }
                }
            },
            {
                "varname": "mxcfdi_config_template_email",
                "vardefault": "",
                "varvalue": "/!/mxcfdi/config/email/template-email/",
                "varcaption": "Plantilla correo",
                "varhelp": "Ir a configuración de plantilla de correo.",
                "vartype": "string",
                "varinput": {
                    "control": "button"
                }
            },
            {
                "varname": "mxcfdi_modif_data_email",
                "vardefault": "0",
                "varvalue": "0",
                "varcaption": "Agregar adjuntos y CC",
                "varhelp": "Permite agregar adjuntos y agregar correos con copia y otros",
                "vartype": "bool",
                "varinput": {
                    "control": "select",
                    "source":{
                        "type":"list",
                        "values":[
                            {"val":"1", "text":"Sí"},
                            {"val":"0", "text":"No"}
                        ],
                        "showfield":"text",
                        "keyfield":"val"
                    }
                }
            },
            {
                "varname": "MXCFDI_IMP_TIPOCLIENTE",
                "vardefault": "1",
                "varvalue": "1",
                "varcaption": "T. de cliente default para clientes al importar",
                "varhelp": "T. de cliente default para clientes al importar",
                "vartype": "string",
                "varinput": {
                    "control": "select",
                    "source":{
                        "type":"query",
                        "query":"SELECT t.sys_pk,CONCAT(t.codigo,' - ',t.descripcion)descripcion FROM tipocliente t WHERE IFNULL(t.sys_deleted,0)=0;",
                        "keyfield":"sys_pk",
                        "showfield":"descripcion"
                    }
                }
            },{
                "varname": "MXCFDI_IMP_TIPOPROVEEDOR",
                "vardefault": "1",
                "varvalue": "1",
                "varcaption": "T. de proveedor default para prov. al importar",
                "varhelp": "T. de proveedor default para proveedores al importar",
                "vartype": "string",
                "varinput": {
                    "control": "select",
                    "source":{
                        "type":"query",
                        "query":"SELECT t.sys_pk,CONCAT(t.codigo,' - ',t.descripcion)descripcion FROM tipoproveedor t WHERE IFNULL(t.sys_deleted,0)=0;",
                        "keyfield":"sys_pk",
                        "showfield":"descripcion"
                    }
                }
            },
            {
                "varname": "mxcfdi_campos_cte_addenda",
                "vardefault": "notas",
                "varvalue": "notas",
                "varcaption": "Campos del cliente en la addenda",
                "varhelp": "Campos del cliente que se agregarán a la addenda, separado por coma (,)",
                "vartype": "string",
                "varinput": {
                    "control": "textarea"
                }
            },
             {
                "varname": "mxcfdi_deliveryFormat",
                "vardefault": "zip",
                "varvalue": "zip",
                "varcaption": "Tipo de entrega del CFDI",
                "varhelp": "Tipo de entrega de los archivos del CFDI",
                "vartype": "string",
                "varinput": {
                    "control": "select",
                    "source":{
                        "type":"list",
                        "values":[
                            {"val":"zip", "text":"zip – Adjunta un archivo ZIP que contiene el XML y el PDF del CFDI"},
                            {"val":"both", "text":"both – Adjunta el archivo XML y el PDF del CFDI"},
                            {"val":"pdf", "text":"pdf – Adjunta únicamente el archivo PDF del CFDI"},
                            {"val":"xml", "text":"xml – Adjunta únicamente el archivo XML del CFDI"},
                            {"val":"link", "text":"link – Incluye un enlace temporal para consultar o descargar los archivos del CFDI.I"}
                        ],
                        "showfield":"text",
                        "keyfield":"val"
                    }
                }
            },
            {
                "varname": "mxcfdi_nombre_archivo",
                "vardefault": "{uuid}",
                "varvalue": "{uuid}",
                "varcaption": "Nombre de los archivos del CFDI",
                "varhelp": "Nombre (sin extensión) del XML y el PDF al descargar o enviar por correo. Marcadores: {uuid}, {uuid8} (primeros 8 caracteres del UUID), {serie}, {folio}, {rfc_emisor}, {referencia} (referencia del documento de V12: venta o movimiento de CxC), {documento} (tipo de comprobante: Factura, Nota de crédito, Recibo de pago, Traslado o Nómina). Ejemplos: {serie}{folio}, {rfc_emisor}_{serie}{folio}, {serie}{folio}_{uuid8}. Alternativas separadas con |: se usa la primera cuyos marcadores tengan todos valor, por ejemplo {serie}{folio}|{referencia} o {documento} {serie}-{folio}|{referencia}. Si ninguna sirve (o el CFDI no tiene serie ni folio, en un patrón sin |) se usa el UUID. Un marcador que no existe (por ejemplo {serie1}) invalida su alternativa. Los caracteres no válidos en nombres de archivo (\\ / : * ? \" < > |) se cambian por _ y el nombre se corta a 80 caracteres.",
                "vartype": "string",
                "varinput": {
                    "control": "text"
                }
            }
        ]
    }
]
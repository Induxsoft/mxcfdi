[
    {
        "id": "mxcfdi",
        "caption": "Emisión de CFDI",
        "help": "Variables del paquete: mxcfdi",
        "vars": [
            {
                "varname": "mxcfdi_config",
                "vardefault": "",
                "varvalue": "/!/mxcfdi/config/",
                "varcaption": "Configuración de emisores",
                "varhelp": "Ir a administración de emisores de CFDI.",
                "vartype": "string",
                "varinput": {
                    "control": "button"
                }
            },
            {
                "varname": "mxcfdi_nventa",
                "vardefault": "0",
                "varvalue": "0",
                "varcaption": "No asumir facturas del módulo de venta",
                "varhelp": "Excluir Facturas y Devoluciones de los comprobantes de Ingreso y Egreso",
                "vartype": "bool",
                "varinput": {
                    "control": "select",
                    "source":{
                        "type":"list",
                        "values":[
                            {"val":"1", "text":"Si"},
                            {"val":"0", "text":"No"}
                        ],
                        "showfield":"text",
                        "keyfield":"val"
                    }
                }
            },
            {
                "varname": "mxcfdi_modif_subject_email",
                "vardefault": "0",
                "varvalue": "0",
                "varcaption": "Editar asunto del correo",
                "varhelp": "Permite editar el asunto del correo",
                "vartype": "bool",
                "varinput": {
                    "control": "select",
                    "source":{
                        "type":"list",
                        "values":[
                            {"val":"1", "text":"Sí"},
                            {"val":"0", "text":"No"}
                        ],
                        "showfield":"text",
                        "keyfield":"val"
                    }
                }
            },
            {
                "varname": "mxcfdi_config_template_email",
                "vardefault": "",
                "varvalue": "/!/mxcfdi/config/email/template-email/",
                "varcaption": "Plantilla correo",
                "varhelp": "Ir a configuración de plantilla de correo.",
                "vartype": "string",
                "varinput": {
                    "control": "button"
                }
            },
            {
                "varname": "mxcfdi_modif_data_email",
                "vardefault": "0",
                "varvalue": "0",
                "varcaption": "Agregar adjuntos y CC",
                "varhelp": "Permite agregar adjuntos y agregar correos con copia y otros",
                "vartype": "bool",
                "varinput": {
                    "control": "select",
                    "source":{
                        "type":"list",
                        "values":[
                            {"val":"1", "text":"Sí"},
                            {"val":"0", "text":"No"}
                        ],
                        "showfield":"text",
                        "keyfield":"val"
                    }
                }
            },
            {
                "varname": "MXCFDI_IMP_TIPOCLIENTE",
                "vardefault": "1",
                "varvalue": "1",
                "varcaption": "T. de cliente default para clientes al importar",
                "varhelp": "T. de cliente default para clientes al importar",
                "vartype": "string",
                "varinput": {
                    "control": "select",
                    "source":{
                        "type":"query",
                        "query":"SELECT t.sys_pk,CONCAT(t.codigo,' - ',t.descripcion)descripcion FROM tipocliente t WHERE IFNULL(t.sys_deleted,0)=0;",
                        "keyfield":"sys_pk",
                        "showfield":"descripcion"
                    }
                }
            },{
                "varname": "MXCFDI_IMP_TIPOPROVEEDOR",
                "vardefault": "1",
                "varvalue": "1",
                "varcaption": "T. de proveedor default para prov. al importar",
                "varhelp": "T. de proveedor default para proveedores al importar",
                "vartype": "string",
                "varinput": {
                    "control": "select",
                    "source":{
                        "type":"query",
                        "query":"SELECT t.sys_pk,CONCAT(t.codigo,' - ',t.descripcion)descripcion FROM tipoproveedor t WHERE IFNULL(t.sys_deleted,0)=0;",
                        "keyfield":"sys_pk",
                        "showfield":"descripcion"
                    }
                }
            }
        ]
    }
]
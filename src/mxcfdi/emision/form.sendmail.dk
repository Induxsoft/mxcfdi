#include "dkli.dkh"
#!
module "form.sendmail.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "uielements.v12.dkl"
    #include "dbr.vars.dkl"
    #include "../_lib/config.dk"

    do @context.begin(@crud_context)

    ref cliente = ifnull(@("&./cliente"),record.create())
    ref doc = ifnull(@("&./doc"),record.create())

    subject=@("$./entity/referencia")+" "+@@(cliente,"$nombre")
    serie = trim(@@(doc,"$serie"))
    folio = trim(@@(doc,"$folio"))

    if serie != "" || folio != ""
    {
        if serie == ""{serie=@("$./entity/referencia")}
        if folio == ""{folio=@("$./entity/referencia")}

        subject=serie + "-"+folio+" "+@@(cliente,"$nombre")
    }
    
    fn_print_buttons::
    {
        #$
        button(class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" type="button" id="btn_submit" title="Enviar correos"){$"Enviar"}
        #!
    }
    point print_buttons to fn_print_buttons

    new nav_config
    {
        @"title": "Enviar CFDI por correo"
        @"buttons*": print_buttons
        member @"hidden" { @"print": @true }
    }
    mxcfdi_modif_subject_email=parse.bool(dbr.vars.get(@("&database"),"mxcfdi_modif_subject_email"))
    mxcfdi_modif_data_email=parse.bool(dbr.vars.get(@("&database"),"mxcfdi_modif_data_email"))   // Habilita CC y adjuntos.
    #$
    div(class="container")
    {
        #! do uie.printV12FormBar(nav_config)

        #$
        link(href="#<@CSS_MAIN>" rel="stylesheet")
        div(class="container-section" id="work_area")
        {
            div(class="alert alert-danger overflow-auto mb-2 #<ifstr(@('$error/message')!='','','d-none')>" id="frm_alerts"){$"#<@('error/message')>"}
            form(method="POST" action="./" id="frm_sendmail" enctype="multipart/form-data")
            {
                input(type="hidden" name="doc" value="#<@('#parameters/doc')>")
                input(type="hidden" name="" value="#<@@(cliente,'$correo')>" id="txt_correos")
                ##
                do uie.print_from_url_field()
                #!
                if mxcfdi_modif_subject_email
                {
                    #$
                    label(class="fw-bold" "for"=""){"Asunto:"}
                    input(class="form-control rounded-0" type="" name="subject" value="#<subject>" id="")

                    div(class="d-flex gap-2 mt-1")
                    {
                        input(type="checkbox" id="check_show_body" onchange="document.getElementById('section_email').classList.toggle('d-none', !this.checked);
                                                                    if (!this.checked) document.getElementById('body').value = '';")
                        label(class="" "for"="check_show_body"){"Cuerpo"}
                    }
                    div(class="d-none" id="section_email")
                    {
                        textarea(class="form-control rounded-0" name="body" id="body" placeholder="Cuerpo ....."){$""}
                    }
                    #!
                }
                ##
                div(class="row")
                {
                    // Captura de correos: "Agregar" los manda a Correos y "CC" a Correos en copia.
                    div(class="col-12")
                    {
                        label(class="form-label" "for"="txt_emails"){$"Ingrese un correo electrónico válido:"}
                        div(class="input-group input-group-sm")
                        {
                            input(class="form-control rounded-0" type="text" name="" value="" id="txt_emails" placeholder="name1@example1.com; name2@example2.com; name3@example3.com ...")
                            button(class="btn btn-secondary rounded-0" type="button" id="btn_add_mail" title="Agregar a destinatarios"){$"Agregar"}
                            #!
                            if mxcfdi_modif_data_email
                            {
                                #$
                                button(class="btn btn-outline-secondary rounded-0" type="button" id="btn_add_cc" title="Agregar con copia (CC)"){$"CC"}
                                #!
                            }
                            #$
                        }
                    }
                    div(class="col-12")
                    {
                        div(class="d-flex justify-content-between align-items-center my-1")
                        {
                            label(class="form-label fw-bold mb-0" "for"="email_list"){$"Correos:"}
                            button(class="btn btn-sm btn-secondary rounded-0" type="button" id="btn_del_mail"){$"Eliminar"}
                        }
                        select(class="form-select" name="" id="email_list" size="5" multiple=""){$""}
                    }
                    #!
                    if mxcfdi_modif_data_email
                    {
                        #$
                        // Con copia (CC)
                        div(class="col-12")
                        {
                            div(class="d-flex justify-content-between align-items-center my-1")
                            {
                                label(class="form-label fw-bold mb-0" "for"="cc_list"){$"Correos en copia (CC):"}
                                button(class="btn btn-sm btn-secondary rounded-0" type="button" id="btn_del_cc"){$"Eliminar"}
                            }
                            select(class="form-select" name="" id="cc_list" size="3" multiple=""){$""}
                        }

                        // Archivos adjuntos
                        div(class="col-12 mt-3")
                        {
                            label(class="form-label fw-bold" "for"="file_adjuntos"){$"Adjuntar archivos:"}
                            input(class="form-control form-control-sm rounded-0" type="file" name="adjuntos" id="file_adjuntos" multiple="")
                            div(class="form-text" id="info_adjuntos"){$""}
                            ul(class="list-group list-group-flush small mt-1" id="lista_adjuntos"){$""}
                        }
                        #!
                    }
                    #$
                }
            }
        }

        script(src="#<@JS_MAIN>"){$""}
        script(src="#<@JS_FORM_SENDMAIL>"){$""}
        script(type="text/javascript")
        {$'
            document.addEventListener("DOMContentLoaded", () => {
                mail.formId = "frm_sendmail";
                mail.init();
            });
        '}
    }
    #!

    do @context.end()
}
